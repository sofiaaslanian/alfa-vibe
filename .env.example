# Public deployment
DOMAIN=demo.example.ru
ACME_EMAIL=team@example.ru

# AlfaGen LLM (proxy only — never log the key)
ALFAGEN_API_KEY=your-key-here
ALFAGEN_BASE_URL=https://alfagen.alfabank.ru/continue-dev/
ALFAGEN_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Service
HOST=0.0.0.0
PORT=8080
WORKERS=4
CONFIG_PATH=config.yaml

# State: memory | redis
STORAGE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
STATE_TTL=3600
STATE_SEEN_TTL=86400
# Generate unique values on the server: openssl rand -hex 32
STATE_HMAC_KEY=change-me-hmac
STATE_ENC_KEY=change-me-enc

# Proxy allowlist (comma-separated). /process stays compatible with the jury tester.
PROXY_API_KEYS=change-me-demo-key

# NER / FIO
# Load / RU RPS path: NER_ENABLED=0 (FIO is still detected by labelled/role rules).
NER_ENABLED=0
NER_LOCAL=1
NER_MODEL=redmadrobot-rnd/rubert-base-pii-ner
NER_FAIL_CLOSED=0
NER_TIMEOUT=30
NER_DEVICE=-1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
