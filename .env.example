# AlfaGen LLM credentials (только в .env, не коммитить!)
ALFAGEN_API_KEY=your-key-here
ALFAGEN_BASE_URL=https://alfagen.alfabank.ru/continue-dev/
ALFAGEN_MODEL=deepseek-v.4-flash

# Service
HOST=0.0.0.0
PORT=8080
WORKERS=4

# NER / FIO via RuBERT (redmadrobot-rnd/rubert-base-pii-ner)
# 1 = включить; без NER_URL грузит модель локально (CPU)
NER_ENABLED=1
NER_URL=
NER_LOCAL=1
NER_MODEL=redmadrobot-rnd/rubert-base-pii-ner
NER_FAIL_CLOSED=0
NER_TIMEOUT=30
NER_DEVICE=-1
CONFIG_PATH=config.yaml