# AlfaGen LLM (proxy only — never log the key)
ALFAGEN_API_KEY=your-key-here
ALFAGEN_BASE_URL=https://alfagen.alfabank.ru/continue-dev/
ALFAGEN_MODEL=deepseek-v.4-flash

# Service
HOST=0.0.0.0
PORT=8080
WORKERS=4
CONFIG_PATH=config.yaml

# State: memory | redis
STORAGE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
# Official mask↔demask pairs are near-instant — consider 300–900s for load tests.
# 3600s is conservative and expensive at 1k new payload_id/s (Redis RAM).
STATE_TTL=3600
STATE_SEEN_TTL=86400
# hex or passphrase (hashed) — generate fresh secrets on the server; never commit .env
#   python -c "import secrets; print(secrets.token_hex(32)); print(secrets.token_hex(32))"
STATE_HMAC_KEY=change-me-hmac
STATE_ENC_KEY=change-me-enc

# Auth only for /proxy and /demo UI — /process autotest is open (org Q&A).
PROXY_API_KEYS=demo-key

# Soft reject under load (not an SLA error). ~200 sync clients in the load profile.
PROCESS_CONCURRENCY=180

# NER / FIO — RuBERT for free-text names (demo/proxy).
# ML finds name spans; discourse decides client vs famous (Пушкин / поэт).
# Install: pip install -r requirements-ner.txt
# Load /process (autotest) keeps use_ner: false in config.yaml for RPS.
NER_ENABLED=1
NER_LOCAL=1
NER_MODEL=redmadrobot-rnd/rubert-base-pii-ner
NER_FAIL_CLOSED=0
NER_TIMEOUT=30
NER_DEVICE=-1
# Prefer offline cache on RU (no HuggingFace egress)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
