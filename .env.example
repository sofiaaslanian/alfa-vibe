# AlfaGen LLM (proxy only — never log the key)
ALFAGEN_API_KEY=your-key-here
ALFAGEN_BASE_URL=https://alfagen.alfabank.ru/continue-dev/
ALFAGEN_MODEL=deepseek-v.4-flash

# Service
HOST=0.0.0.0
PORT=8080
WORKERS=4
CONFIG_PATH=config.yaml

# State: memory | redis
STORAGE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
STATE_TTL=3600
STATE_SEEN_TTL=86400
# hex or passphrase (hashed) — set real secrets in prod
STATE_HMAC_KEY=change-me-hmac
STATE_ENC_KEY=change-me-enc

# Proxy allowlist (comma-separated). Empty = open local demo only.
PROXY_API_KEYS=demo-key

# NER / FIO
# Load / RU RPS path: NER_ENABLED=0 (ФИО всё ещё ловят labelled/role rules).
# Demo quality with RuBERT: NER_ENABLED=1 + model in HF cache.
NER_ENABLED=0
NER_LOCAL=1
NER_MODEL=redmadrobot-rnd/rubert-base-pii-ner
NER_FAIL_CLOSED=0
NER_TIMEOUT=30
NER_DEVICE=-1
# Prefer offline cache on RU (no HuggingFace egress)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
