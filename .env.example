# Public deployment
DOMAIN=alfa.example.ru
ACME_EMAIL=team@example.ru

# AlfaGen LLM (proxy only — never log the key)
ALFAGEN_API_KEY=your-key-here
ALFAGEN_BASE_URL=https://alfagen.alfabank.ru/continue-dev/
ALFAGEN_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Service
HOST=0.0.0.0
PORT=8080
WORKERS=4
CONFIG_PATH=config.yaml

# State: memory | redis
STORAGE_BACKEND=redis
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=1gb
# Official mask↔demask pairs are near-instant — 900s covers the five-minute load run.
STATE_TTL=900
STATE_SEEN_TTL=86400
# Generate fresh secrets on the server; never commit .env.
#   python -c "import secrets; print(secrets.token_hex(32)); print(secrets.token_hex(32))"
STATE_HMAC_KEY=change-me-hmac
STATE_ENC_KEY=change-me-enc

# Auth only for /proxy and /demo UI — /process stays open for AlfaSonar.
PROXY_API_KEYS=change-me-demo-key

# Soft reject under load. Tune only after a measured public load run.
PROCESS_CONCURRENCY=180

# The production Docker image is intentionally slim and does not install torch.
# Keep NER off for the public /process load path.
NER_ENABLED=0
NER_LOCAL=1
NER_MODEL=redmadrobot-rnd/rubert-base-pii-ner
NER_FAIL_CLOSED=0
NER_TIMEOUT=30
NER_DEVICE=-1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
